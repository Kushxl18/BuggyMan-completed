# ============================================================================
# BuggyMan Docker Environment Configuration Template
# Copy this file to .env before running: docker compose up -d
# ============================================================================

# Database Configuration (Leave default for local Docker PostgreSQL, or use Neon cloud URL)
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/buggyman
POSTGRES_DB=buggyman
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Django Production Security
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,yourdomain.com
FRONTEND_BASE_URL=http://localhost:3000

# Gunicorn Process Settings
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# AI Provider Keys (Optional - at least one recommended for hints/career engine)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# OAuth 2.0 Provider Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payment Gateway (Razorpay - Optional / Dummy test mode supported)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
