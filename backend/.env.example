# BuggyMan Backend Environment Configuration Example

# Django Secret Key & Debug Mode
# Generate a strong key in production via: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-buggyman-prod-key-change-in-production
DEBUG=False

# Hosts and CORS (comma-separated domains allowed to connect)
ALLOWED_HOSTS=api.buggyman.dev,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://buggyman.dev,http://localhost:3000
SECURE_SSL_REDIRECT=false

# ==============================================================================
# Database Configuration (PostgreSQL / SQLite)
# ==============================================================================
# In production, specify a standard PostgreSQL DATABASE_URL or discrete DB_* parameters.
# If DATABASE_URL is left empty and DB_ENGINE=sqlite, BuggyMan falls back to SQLite.
#
# Option A: Full Connection URI (Neon, Supabase, Railway, Render, AWS RDS, Docker)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buggyman
DATABASE_URL=

# Option B: Discrete Parameters
DB_ENGINE=sqlite
DB_NAME=buggyman
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=false
DB_CONN_MAX_AGE=600

# ==============================================================================
# AI Provider Configuration (For BugBytes AI Hints)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ==============================================================================
# OAuth 2.0 Single Sign-On (Google, GitHub)
# ==============================================================================
# Frontend callback URL (default: http://localhost:3000/auth/callback)
FRONTEND_BASE_URL=http://localhost:3000

# Google OAuth (Console: https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Settings: https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
