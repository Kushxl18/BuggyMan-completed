# BuggyMan Frontend Environment Configuration

# Backend API base URL
# In local development with Vite dev server proxying '/api' -> http://127.0.0.1:8000,
# leave this as '/api'.
# In production (e.g. Vercel, Netlify), set this to your backend domain:
# e.g., https://api.buggyman.com/api or https://buggyman-backend.onrender.com/api
VITE_API_BASE_URL=/api

# Enable mock DB fallback (true / false)
# When set to false, network errors surface transparently rather than silently falling back
# to in-browser localStorage mock data.
# Defaults to true in development, false in production builds.
VITE_ENABLE_MOCK_FALLBACK=false
